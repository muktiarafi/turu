# One account's settings for compose.yaml (docs/HEADLESS.md, "Docker"). Copy it to
# docker/<account>.env, which git ignores: it holds a password.

TURU_USER=YourName
TURU_PASSWORD=your password
# A quiet server, so relogins find room.
TURU_SERVER=Yorumi

# What to run: a script (relative to the data folder's scripts folder, downloaded if Search
# Scripts lists it) or a playlist file inside the data folder, e.g. /data/playlists/daily.json.
TURU_RUN_SCRIPT=farm/GoldFarm
# TURU_RUN_PLAYLIST=/data/playlists/daily.json

# The control API (on in the image at 0.0.0.0:9021) wants a token of 32 characters at least,
# e.g. from `openssl rand -hex 32`; without one Turu makes the data folder's `api-token`.
TURU_API_TOKEN=
# The web monitor. Reached through Docker's network, it asks for the data folder's `monitor-key`:
# open http://localhost:8790/#<key>.
TURU_MONITOR=0.0.0.0:8790
# Or report to another account's monitor instead (the key: the data folder's `monitor-push-key`).
# TURU_REPORT_TO=http://main:8790
# TURU_MONITOR_PUSH_KEY=

# RUST_LOG=warn,turu=debug
