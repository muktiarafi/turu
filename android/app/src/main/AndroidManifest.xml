<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The slots' services: keep the game's network while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- While a script runs, and leaving Turu out of battery optimisation (asked once). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Installing an update's APK (PackageUpdate.kt); Android asks the user each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: lets Turu install its own update without Android's confirmation each time
         (granted at install; PackageUpdate.kt asks for it with setRequireUserAction). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- TuruActivity (a GameActivity, AndroidX's) runs the Rust side, libturu_android.so. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name">
        <!-- Sentry starts only once the user agreed to send crash reports (CrashUploads.kt). -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <!-- windowSoftInputMode: TuruActivity sets it again in onCreate. Theme.Turu: GameActivity is
             an AppCompatActivity. -->
        <activity
            android:name=".TuruActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Turu"
            android:windowSoftInputMode="adjustNothing">
            <meta-data
                android:name="android.app.lib_name"
                android:value="turu_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Each tab's engine in a process of its own (docs/TAB_PROCESSES_PROPOSAL.md, M3 and M6:
             SlotService.kt). -->
        <service
            android:name=".Slot1Service"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":c1">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a game client and its bot script while the app is in the background" />
        </service>
        <service
            android:name=".Slot2Service"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":c2">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a game client and its bot script while the app is in the background" />
        </service>
